[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

# The app modules are run by Streamlit, not imported as a package. Declaring no
# modules keeps `uv pip install -e .` from failing on flat-layout discovery.
[tool.setuptools]
py-modules = []

[project]
name = "data-app"
version = "0.1.0"
description = "Local Streamlit and Polars data app"
requires-python = ">=3.10"
dependencies = [
    "streamlit>=1.36",
    "polars>=1.0",
    "pyarrow>=15",
    "pandas>=2.0",
    # SQL datasource (optional):
    # "connectorx>=0.3",
    # HTTP datasource (optional):
    # "requests>=2.31",
]
